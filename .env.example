# WP Auto Poster — configuration template
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# On shared hosting where cron jobs cannot inherit process environment
# variables, define these as PHP constants in wp-config.php instead — the
# resolver checks constants first, then real env vars, then this file.
#
#   define( 'WPAP_API_KEY', 'sk-ant-...' );
#
# Only WPAP_API_KEY is strictly required. Everything else has a working default.

# ---------------------------------------------------------------------------
# Anthropic API
# ---------------------------------------------------------------------------

# REQUIRED. Anthropic API key. Use a key scoped to this site so spend is attributable per-site.
WPAP_API_KEY=

# Model that writes the article.
WPAP_MODEL=claude-sonnet-5

# Cheap model used only to pick an anchor product when keyword scoring finds no word match.
WPAP_MODEL_CHEAP=claude-haiku-4-5

# Output token ceiling for one article. Below ~6000 long articles get truncated.
WPAP_MAX_TOKENS=8192

# Seconds to wait for the API before giving up.
WPAP_TIMEOUT=300

# ---------------------------------------------------------------------------
# Cron security
# ---------------------------------------------------------------------------

# Shared secret for triggering cron-post.php over HTTP as ?key=... Leave empty to allow CLI only.
WPAP_CRON_SECRET=

# ---------------------------------------------------------------------------
# Publishing
# ---------------------------------------------------------------------------

# WordPress user ID that authors the generated posts.
WPAP_POST_AUTHOR=1

# Category term_id the generated posts are filed under.
WPAP_POST_CATEGORY=1

# publish | draft — use draft when a human reviews before the post goes live.
WPAP_POST_STATUS=draft

# Keywords consumed per run. Keep at 1 and control volume with the cron schedule.
WPAP_PER_RUN=1

# ---------------------------------------------------------------------------
# Article rules
# ---------------------------------------------------------------------------

# Minimum body words. Articles shorter than this are rejected, not published.
WPAP_MIN_WORDS=1000

# Length the prompt aims for.
WPAP_TARGET_WORDS=1200

# Minimum number of <h2> sections.
WPAP_MIN_H2=4

# Maximum number of <h2> sections.
WPAP_MAX_H2=6

# true | false — restrict the anchor pool to in-stock products only.
WPAP_REQUIRE_IN_STOCK=true

# true | false — count "on backorder" as in stock.
WPAP_ALLOW_BACKORDER=false

# Maximum words allowed inside any single hyperlink's anchor text.
WPAP_LINK_WORDS=6

# Maximum words in a generated post slug.
WPAP_SLUG_MAX_WORDS=5

# Maximum characters in a generated post slug.
WPAP_SLUG_MAX_CHARS=60

# How many recent articles' brands/models to avoid when picking the next anchor.
WPAP_VARIETY_WINDOW=6

# Deprecated, retained for backwards compatibility. Rotation is no longer time-based.
WPAP_ROTATION_DAYS=120

# How many recent headlines the model is shown and told to differ from.
WPAP_RECENT_TITLES=30

# ---------------------------------------------------------------------------
# Cover images
# ---------------------------------------------------------------------------

# Folder under wp-content/uploads/ holding the cover photo pool.
WPAP_COVER_DIR=blog-covers

# Warn in wp-admin once this many unused covers remain.
WPAP_COVER_LOW_WARN=14

# ---------------------------------------------------------------------------
# IndexNow (optional)
# ---------------------------------------------------------------------------

# IndexNow key for pinging Bing/Yandex on publish. Leave empty to disable.
# The matching <key>.txt file must exist at the site root or the ping is rejected.
WPAP_INDEXNOW_KEY=

# ---------------------------------------------------------------------------
# Site profile
# ---------------------------------------------------------------------------

# Business name used in prompts, image alt text and captions.
WPAP_SITE_NAME=Example Auto Parts

# One-line positioning statement shown to the model.
WPAP_SITE_TAGLINE=Specialist parts and accessories

# Where the business operates, for local context in the copy.
WPAP_SITE_LOCATION=City, Country

# Comma-separated allow-list — the ONLY external domains an article may link to.
WPAP_ALLOWED_EXTERNAL_DOMAINS=example-manufacturer.com,another-manufacturer.com

# Optional forced domain rewrites, "wrong>right" pairs, comma separated.
# Use when a partner's canonical site is a country TLD the model keeps guessing wrong.
# WPAP_DOMAIN_FIXES=partner.com>partner.co.uk,www.partner.com>partner.co.uk

# Optional explicit path to the .env file, if it does not sit in a default location.
# WPAP_ENV_FILE=/var/www/secrets/.env
